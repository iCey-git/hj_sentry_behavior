<?xml version="1.0" encoding="UTF-8"?>
<!--
  测试行为树: 比赛开始 -> 小陀螺 + 去目标点
  - 检测到敌人: 停底盘，交给自瞄打
  - 机器人状态不好: 回起始点

  使用前请修改:
  - target_goal (目标点)
  - home_goal   (起始点)
-->
<root BTCPP_format="4">

  <!-- 子树: 比赛开始判定 -->
  <BehaviorTree ID="check_game_start">
    <Fallback>
      <IsGameStatus name="IsGameStart"
                    max_remain_time="420"
                    min_remain_time="0"
                    expected_game_progress="4"
                    key_port="{@referee_gameStatus}"/>
      <ForceFailure>
        <Sequence>
          <PublishModeControl chassis_gyro="0"
                              patrol_mode="255"
                              power_mode="12"
                              duration="0.0"
                              topic_name="/mode_ctrl"/>
          <PublishTwist v_y="0.0"
                        v_yaw="0.0"
                        v_x="0.0"
                        duration="0.0"
                        topic_name="cmd_vel"/>
        </Sequence>
      </ForceFailure>
    </Fallback>
  </BehaviorTree>

  <!-- 子树: 状态异常则回家 -->
  <BehaviorTree ID="return_home">
    <Sequence>
      <PublishModeControl chassis_gyro="0"
                          patrol_mode="255"
                          power_mode="12"
                          duration="0.0"
                          topic_name="/mode_ctrl"/>
      <PubNav2Goal goal="0;0;0"
                   topic_name="goal_pose"/>
    </Sequence>
  </BehaviorTree>

  <!-- 子树: 敌人出现 -> 停底盘，让自瞄接管 -->
  <BehaviorTree ID="stop_for_enemy">
    <Sequence>
      <IsDetectEnemy armor_id="1;2;3;4;5;7"
                    max_distance="8.0"
                    key_port="{@detector_armors}"/>
      <PublishModeControl chassis_gyro="1"
                          patrol_mode="2"
                          power_mode="12"
                          duration="0.0"
                          topic_name="/mode_ctrl"/>
      <PublishTwist v_y="0.0"
                    v_yaw="0.0"
                    v_x="0.0"
                    duration="0.0"
                    topic_name="cmd_vel"/>
    </Sequence>
  </BehaviorTree>

  <!-- 子树: 正常巡航 -> 开小陀螺 + 去目标点 -->
  <BehaviorTree ID="go_to_target">
    <Sequence>
      <PublishModeControl chassis_gyro="1"
                          patrol_mode="2"
                          power_mode="12"
                          duration="0.0"
                          topic_name="/mode_ctrl"/>
      <PubNav2Goal goal="4.65;-3.5;0"
                   topic_name="goal_pose"/>
    </Sequence>
  </BehaviorTree>

  <!-- 主行为树 -->
  <BehaviorTree ID="test_spin_nav_aim">
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <ReactiveSequence>
          <SubTree ID="check_game_start"/>
          <ReactiveFallback>
            <!-- 状态异常优先 -->
            <ReactiveSequence>
              <Inverter>
                <IsStatusOK ammo_min="0"
                            heat_max="350"
                            hp_min="200"
                            key_port="{@referee_robotStatus}"/>
              </Inverter>
              <SubTree ID="return_home"/>
            </ReactiveSequence>
            <!-- 有敌人: 停底盘 -->
            <SubTree ID="stop_for_enemy"/>
            <!-- 正常: 小陀螺 + 去目标点 -->
            <SubTree ID="go_to_target"/>
          </ReactiveFallback>
        </ReactiveSequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- 节点模型 (Groot可视化用) -->
  <TreeNodesModel>
    <Condition ID="IsGameStatus">
      <input_port name="max_remain_time"
                  default="420"
                  type="int">Maximum remaining time (s)</input_port>
      <input_port name="min_remain_time"
                  default="0"
                  type="int">Minimum remaining time (s)</input_port>
      <input_port name="expected_game_progress"
                  default="4"
                  type="int">Expected game progress stage</input_port>
      <input_port name="key_port"
                  default="{@referee_gameStatus}"
                  type="robot_msgs::msg::CompetitionInfo_&lt;std::allocator&lt;void&gt; &gt;">CompetitionInfo port on blackboard</input_port>
    </Condition>
    <Condition ID="IsStatusOK">
      <input_port name="ammo_min"
                  default="0"
                  type="int">Lower then minimum ammo will return FAILURE</input_port>
      <input_port name="heat_max"
                  default="350"
                  type="int">Maximum heat. NOTE: Sentry heat limit is 400</input_port>
      <input_port name="hp_min"
                  default="300"
                  type="int">Minimum HP. NOTE: Sentry init/max HP is 400</input_port>
      <input_port name="key_port"
                  default="{@referee_robotStatus}"
                  type="robot_msgs::msg::CompetitionInfo_&lt;std::allocator&lt;void&gt; &gt;">CompetitionInfo port on blackboard</input_port>
    </Condition>
    <Condition ID="IsDetectEnemy">
      <input_port name="armor_id"
                  default="1;2;3;4;5;7"
                  type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;">Expected id of armors</input_port>
      <input_port name="max_distance"
                  default="8.000000"
                  type="float">Distance to enemy target</input_port>
      <input_port name="key_port"
                  default="{@detector_armors}"
                  type="auto_aim_interfaces::msg::Armors_&lt;std::allocator&lt;void&gt; &gt;">Vision detector port on blackboard</input_port>
    </Condition>
    <Condition ID="PubNav2Goal">
      <input_port name="goal"
                  default="0;0;0"
                  type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</input_port>
      <input_port name="topic_name"
                  default="__default__placeholder__"
                  type="std::string">Topic name</input_port>
    </Condition>
    <Action ID="PublishModeControl">
      <input_port name="chassis_gyro"
                  default="0"
                  type="int">0: off, 1: on</input_port>
      <input_port name="patrol_mode"
                  default="2"
                  type="int">Patrol mode (e.g. 2=normal, 255=relax)</input_port>
      <input_port name="power_mode"
                  default="12"
                  type="int">Power mode (e.g. 12=charge, 13=boost)</input_port>
      <input_port name="duration"
                  type="std::chrono::milliseconds">Publish then sleep duration in milliseconds</input_port>
      <input_port name="topic_name"
                  default="__default__placeholder__"
                  type="std::string">Topic name</input_port>
    </Action>
    <Action ID="PublishTwist">
      <input_port name="v_y"
                  default="0.000000"
                  type="double">Linear Y velocity (m/s)</input_port>
      <input_port name="v_yaw"
                  default="0.000000"
                  type="double">Angular Z velocity (rad/s)</input_port>
      <input_port name="v_x"
                  default="0.000000"
                  type="double">Linear X velocity (m/s)</input_port>
      <input_port name="duration"
                  type="std::chrono::milliseconds">Publish then sleep duration in milliseconds</input_port>
      <input_port name="topic_name"
                  default="__default__placeholder__"
                  type="std::string">Topic name</input_port>
    </Action>
  </TreeNodesModel>

</root>
