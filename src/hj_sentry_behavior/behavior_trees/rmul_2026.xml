<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">

  <!-- 子树: 比赛开始判定 -->
  <BehaviorTree ID="check_game_start">
    <Fallback>
      <IsGameStatus name="IsGameStart"
                    max_remain_time="420"
                    min_remain_time="0"
                    expected_game_progress="4"
                    key_port="{@referee_gameStatus}"/>
      <ForceFailure>
        <Sequence>
          <PublishModeControl chassis_gyro="0"
                              patrol_mode="255"
                              power_mode="12"
                              duration="0.0"
                              topic_name="/mode_ctrl"/>
          <PublishTwist v_y="0.0"
                        v_yaw="0.0"
                        v_x="0.0"
                        duration="0.0"
                        topic_name="cmd_vel"/>
        </Sequence>
      </ForceFailure>
    </Fallback>
  </BehaviorTree>

  <!-- 子树: 状态异常则回家 → 先走精确点, 友军占了则搜索附近可达点 -->
  <BehaviorTree ID="return_home">
    <Sequence>
      <!-- 首次导航: 模式1 -->
      <PublishModeControl chassis_gyro="1"
                          patrol_mode="2"
                          power_mode="12"
                          duration="0"
                          topic_name="/mode_ctrl"/>
      <ForceSuccess>
        <Fallback>
          <!-- 优先: 精确回到起始点 -->
          <Nav2Pose action_name="navigate_to_pose"
                    goal_pose_topic="/goal_pose"
                    goal="-0.2;-0.8;0"/>
          <!-- 兜底: 友军占了 → 查 costmap 找附近可达点 -->
          <Sequence>
            <FindReachableGoalInArea center="-0.2;-0.8;0"
                                     radius="1.5"
                                     cost_threshold="50"
                                     costmap_port="{@nav_globalCostmap}"
                                     goal="{reachable_home}"/>
            <Nav2Pose action_name="navigate_to_pose"
                      goal_pose_topic="/goal_pose"
                      goal="{reachable_home}"/>
          </Sequence>
        </Fallback>
      </ForceSuccess>
      <!-- 到达后: 全程模式2纠偏 -->
      <KeepRunningUntilFailure>
        <Sequence>
          <PublishModeControl chassis_gyro="2"
                              patrol_mode="2"
                              power_mode="12"
                              duration="0"
                              topic_name="/mode_ctrl"/>
          <ForceSuccess>
            <TickAfterTimeout timeout="10.0">
              <Fallback>
                <Nav2Pose action_name="navigate_to_pose"
                          goal_pose_topic="/goal_pose"
                          goal="-0.2;-0.8;0"/>
                <Sequence>
                  <FindReachableGoalInArea center="-0.2;-0.8;0"
                                           radius="1.5"
                                           cost_threshold="50"
                                           costmap_port="{@nav_globalCostmap}"
                                           goal="{reachable_home}"/>
                  <Nav2Pose action_name="navigate_to_pose"
                            goal_pose_topic="/goal_pose"
                            goal="{reachable_home}"/>
                </Sequence>
              </Fallback>
            </TickAfterTimeout>
          </ForceSuccess>
        </Sequence>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>

  <!-- 子树: 敌人出现 -> 停底盘，让自瞄接管 -->
  <BehaviorTree ID="stop_for_enemy">
    <Sequence>
      <IsDetectEnemy armor_id="1;2;3;4;5;7"
                    max_distance="8.0"
                    key_port="{@detector_armors}"/>
      <PublishModeControl chassis_gyro="1"
                          patrol_mode="255"
                          power_mode="12"
                          duration="0"
                          topic_name="/mode_ctrl"/>
      <PublishTwist v_y="0.0"
                    v_yaw="0.0"
                    v_x="0.0"
                    duration="0"
                    topic_name="cmd_vel"/>
    </Sequence>
  </BehaviorTree>

  <!-- 子树: 正常巡航 → 先走精确目标点, 被占则搜索区域可达点 -->
  <BehaviorTree ID="go_to_target">
    <Sequence>
      <!-- 首次导航: 模式1 -->
      <PublishModeControl chassis_gyro="1"
                          patrol_mode="2"
                          power_mode="12"
                          duration="0"
                          topic_name="/mode_ctrl"/>
      <ForceSuccess>
        <Fallback>
          <!-- 优先: 直接导航到精确目标点 -->
          <Nav2Pose action_name="navigate_to_pose"
                    goal_pose_topic="/goal_pose"
                    goal="5.5;-4.1;0"/>
          <!-- 兜底: 目标被占 → 查 costmap 找附近可达点 -->
          <Sequence>
            <FindReachableGoalInArea center="5.5;-4.1;0"
                                     radius="2.0"
                                     cost_threshold="50"
                                     costmap_port="{@nav_globalCostmap}"
                                     goal="{reachable_goal}"/>
            <Nav2Pose action_name="navigate_to_pose"
                      goal_pose_topic="/goal_pose"
                      goal="{reachable_goal}"/>
          </Sequence>
        </Fallback>
      </ForceSuccess>
      <!-- 到达后: 全程模式2纠偏 -->
      <KeepRunningUntilFailure>
        <Sequence>
          <PublishModeControl chassis_gyro="2"
                              patrol_mode="2"
                              power_mode="12"
                              duration="0"
                              topic_name="/mode_ctrl"/>
          <ForceSuccess>
            <TickAfterTimeout timeout="10.0">
              <Fallback>
                <Nav2Pose action_name="navigate_to_pose"
                          goal_pose_topic="/goal_pose"
                          goal="5.5;-4.1;0"/>
                <Sequence>
                  <FindReachableGoalInArea center="5.5;-4.1;0"
                                           radius="2.0"
                                           cost_threshold="50"
                                           costmap_port="{@nav_globalCostmap}"
                                           goal="{reachable_goal}"/>
                  <Nav2Pose action_name="navigate_to_pose"
                            goal_pose_topic="/goal_pose"
                            goal="{reachable_goal}"/>
                </Sequence>
              </Fallback>
            </TickAfterTimeout>
          </ForceSuccess>
        </Sequence>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>

  <!-- 主行为树 -->
  <BehaviorTree ID="rmul_2026">
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <ReactiveSequence>
          <SubTree ID="check_game_start"/>
          <ReactiveFallback>
            <!-- 状态异常优先 -->
            <ReactiveSequence>
              <Inverter>
                <IsStatusOK ammo_min="0"
                            heat_max="350"
                            hp_min="200"
                            key_port="{@referee_robotStatus}"/>
              </Inverter>
              <SubTree ID="return_home"/>
            </ReactiveSequence>
            <!-- 有敌人: 停底盘 -->
            <SubTree ID="stop_for_enemy"/>
            <!-- 正常: 小陀螺 + 去目标点 -->
            <SubTree ID="go_to_target"/>
          </ReactiveFallback>
        </ReactiveSequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- 节点模型 (Groot可视化用) -->
  <TreeNodesModel>
    <Condition ID="IsGameStatus">
      <input_port name="max_remain_time"
                  default="420"
                  type="int">Maximum remaining time (s)</input_port>
      <input_port name="min_remain_time"
                  default="0"
                  type="int">Minimum remaining time (s)</input_port>
      <input_port name="expected_game_progress"
                  default="4"
                  type="int">Expected game progress stage</input_port>
      <input_port name="key_port"
                  default="{@referee_gameStatus}"
                  type="robot_msgs::msg::CompetitionInfo_&lt;std::allocator&lt;void&gt; &gt;">CompetitionInfo port on blackboard</input_port>
    </Condition>
    <Condition ID="IsStatusOK">
      <input_port name="ammo_min"
                  default="0"
                  type="int">Lower then minimum ammo will return FAILURE</input_port>
      <input_port name="heat_max"
                  default="350"
                  type="int">Maximum heat. NOTE: Sentry heat limit is 400</input_port>
      <input_port name="hp_min"
                  default="300"
                  type="int">Minimum HP. NOTE: Sentry init/max HP is 400</input_port>
      <input_port name="key_port"
                  default="{@referee_robotStatus}"
                  type="robot_msgs::msg::CompetitionInfo_&lt;std::allocator&lt;void&gt; &gt;">CompetitionInfo port on blackboard</input_port>
    </Condition>
    <Condition ID="IsDetectEnemy">
      <input_port name="armor_id"
                  default="1;2;3;4;5;7"
                  type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;">Expected id of armors</input_port>
      <input_port name="max_distance"
                  default="8.000000"
                  type="float">Distance to enemy target</input_port>
      <input_port name="key_port"
                  default="{@detector_armors}"
                  type="auto_aim_interfaces::msg::Armors_&lt;std::allocator&lt;void&gt; &gt;">Vision detector port on blackboard</input_port>
    </Condition>
    <Action ID="Nav2Pose">
      <input_port name="goal"
                  default="0;0;0"
                  type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Expected goal pose that send to nav2. Fill with format `x;y;yaw`</input_port>
      <input_port name="action_name"
                  default="navigate_to_pose"
                  type="std::string">Action server name</input_port>
      <input_port name="goal_pose_topic"
                  default="/goal_pose"
                  type="std::string">Goal pose topic for yaw controller</input_port>
    </Action>
    <Action ID="FindReachableGoalInArea">
      <input_port name="center"
                  default="0;0;0"
                  type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Center of search area. Fill with format `x;y;yaw`</input_port>
      <input_port name="radius"
                  default="2.0"
                  type="double">Search radius in meters</input_port>
      <input_port name="cost_threshold"
                  default="50"
                  type="int">Max costmap cost for a feasible point</input_port>
      <input_port name="costmap_port"
                  default="{@nav_globalCostmap}"
                  type="nav_msgs::msg::OccupancyGrid_&lt;std::allocator&lt;void&gt; &gt;">GlobalCostmap port on blackboard</input_port>
      <output_port name="goal"
                   default="{reachable_goal}"
                   type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Output: nearest reachable goal pose within the area</output_port>
    </Action>
    <Action ID="PublishModeControl">
      <input_port name="chassis_gyro"
                  default="0"
                  type="int">0: off, 1: on</input_port>
      <input_port name="patrol_mode"
                  default="2"
                  type="int">Patrol mode (e.g. 2=normal, 255=relax)</input_port>
      <input_port name="power_mode"
                  default="12"
                  type="int">Power mode (e.g. 12=charge, 13=boost)</input_port>
      <input_port name="duration"
                  type="std::chrono::milliseconds">Publish then sleep duration in milliseconds</input_port>
      <input_port name="topic_name"
                  default="__default__placeholder__"
                  type="std::string">Topic name</input_port>
    </Action>
    <Action ID="PublishTwist">
      <input_port name="v_y"
                  default="0.000000"
                  type="double">Linear Y velocity (m/s)</input_port>
      <input_port name="v_yaw"
                  default="0.000000"
                  type="double">Angular Z velocity (rad/s)</input_port>
      <input_port name="v_x"
                  default="0.000000"
                  type="double">Linear X velocity (m/s)</input_port>
      <input_port name="duration"
                  type="std::chrono::milliseconds">Publish then sleep duration in milliseconds</input_port>
      <input_port name="topic_name"
                  default="__default__placeholder__"
                  type="std::string">Topic name</input_port>
    </Action>
  </TreeNodesModel>

</root>
