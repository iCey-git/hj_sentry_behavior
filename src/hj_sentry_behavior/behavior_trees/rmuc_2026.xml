<?xml version="1.0" encoding="UTF-8"?>
<!--
  RMUC 2026 哨兵主行为树
  ========================
  策略层: SCURM 优先级框架
    P0: check_game_start   — 比赛未开始则停车等待
    P1: check_death        — 我方哨兵 HP==0, 死循环等待复活
    P2: check_supply       — HP/弹药不足, 区域选路回补给
    P3: protect_base       — 我方基地 HP 低, 去基地附近守护
    P4: engage_enemy       — 检测到敌人, 停底盘交给自瞄
    P5: pressure_outpost   — 敌方前哨站存活, 去打前哨站
    P6: patrol_by_phase    — 按剩余时间前后期巡逻

  接口基线 (来自 test_spin_nav_aim.xml):
    Nav2Pose: action_name="navigate_to_pose" goal_pose_topic="/goal_pose" goal="x;y;yaw"
    PublishModeControl: chassis_gyro / patrol_mode / power_mode / duration / topic_name="/mode_ctrl"
    IsGameStatus: expected_game_progress / key_port="{@referee_gameStatus}"
    IsStatusOK: ammo_min / hp_min / hp_recover / key_port="{@referee_robotStatus}"
    IsDetectEnemy: armor_id / max_distance / key_port="{@detector_armors}"

  参数: 由 sentry_behavior.yaml 注入到黑板 (红蓝方切参数, 路线文件, 区域边界, 阈值)
-->
<root BTCPP_format="4">

  <!-- ═══════════════════════════════════════════════
       工具子树: 通用多点路线执行器
       说明: 加载 CSV 路线后循环执行, 到达最后一个航点后退出
       ═══════════════════════════════════════════════ -->
  <BehaviorTree ID="run_route">
    <!-- 先加载路线, 再逐点执行 -->
    <SequenceWithMemory>
      <LoadWaypoints waypoint_file="{route_file}"
                     waypoints="{route_waypoints}"
                     wait_times="{route_wait_times}"
                     total_waypoints="{route_total_wp}"
                     wp_idx="{route_wp_idx}"/>
      <!-- KeepRunningUntilFailure: NextWaypoint 到头返回 FAILURE 则退出循环 -->
      <KeepRunningUntilFailure>
        <Sequence>
          <GetCurrentWaypoint waypoints="{route_waypoints}"
                              wait_times="{route_wait_times}"
                              wp_idx="{route_wp_idx}"
                              current_goal="{current_goal}"
                              current_wait_sec="{current_wait_sec}"/>
          <!-- 导航途中: 小陀螺 + 正常移动模式 -->
          <PublishModeControl chassis_gyro="1"
                              patrol_mode="2"
                              power_mode="12"
                              duration="0"
                              topic_name="/mode_ctrl"/>
          <!-- ForceSuccess: 导航失败也继续往下走 (切到下个航点) -->
          <ForceSuccess>
            <Nav2Pose action_name="navigate_to_pose"
                      goal_pose_topic="/goal_pose"
                      goal="{current_goal}"/>
          </ForceSuccess>
          <!-- 到达航点后等待 wait_sec -->
          <WaitDuration wait_sec="{current_wait_sec}"/>
          <!-- 推进到下一航点; 到尾则重置 idx 并返回 FAILURE -->
          <NextWaypoint wp_idx="{route_wp_idx}"
                        total_waypoints="{route_total_wp}"/>
        </Sequence>
      </KeepRunningUntilFailure>
    </SequenceWithMemory>
  </BehaviorTree>

  <!-- ═══════════════════════════════════════════════
       P0: 比赛开始判定
       说明: 未开始则停车等待 (与 test_spin_nav_aim.xml 完全一致)
       ═══════════════════════════════════════════════ -->
  <BehaviorTree ID="check_game_start">
    <Fallback>
      <IsGameStatus name="IsGameStart"
                    expected_game_progress="4"
                    key_port="{@referee_gameStatus}"/>
      <ForceFailure>
        <Sequence>
          <PublishModeControl chassis_gyro="0"
                              patrol_mode="255"
                              power_mode="12"
                              duration="0.0"
                              topic_name="/mode_ctrl"/>
          <PublishTwist v_y="0.0"
                        v_yaw="0.0"
                        v_x="0.0"
                        duration="0.0"
                        topic_name="cmd_vel"/>
        </Sequence>
      </ForceFailure>
    </Fallback>
  </BehaviorTree>

  <!-- ═══════════════════════════════════════════════
       P1: 死亡处理
       说明: HP==0 时死循环等待复活, 期间发停车指令
       用法: _while 前置条件, our_sentry_hp==0 时持续触发
       ═══════════════════════════════════════════════ -->
  <BehaviorTree ID="check_death">
    <Sequence _while="our_sentry_hp==0">
      <PublishModeControl chassis_gyro="0"
                          patrol_mode="255"
                          power_mode="12"
                          duration="0"
                          topic_name="/mode_ctrl"/>
      <PublishTwist v_y="0.0"
                    v_yaw="0.0"
                    v_x="0.0"
                    duration="0"
                    topic_name="cmd_vel"/>
      <!-- 死循环: 一直 RUNNING 等待复活 -->
      <AlwaysRunning/>
    </Sequence>
  </BehaviorTree>

  <!-- ═══════════════════════════════════════════════
       P2: 补给逻辑
       说明:
         1. IsStatusOK 返回 FAILURE 表示需要补给
         2. SelectSupplyRouteByArea 按位置选路线 (锁定本次补给路线)
         3. 沿选定路线走到补给区
         4. 等待补给完成 (IsStatusOK 返回 SUCCESS 且锁解除)
       _while 条件: 补给条件满足 OR 锁定中
       ═══════════════════════════════════════════════ -->
  <BehaviorTree ID="reset_supply_route">
    <ResetSupplyRoute selected_supply_route="{selected_supply_route}"
                      supply_route_locked="{supply_route_locked}"/>
  </BehaviorTree>

  <BehaviorTree ID="check_supply">
    <!-- Inverter: IsStatusOK==SUCCESS → Inverter→FAILURE, 不需补给则跳过 -->
    <Fallback>
      <SequenceWithMemory>
        <Inverter>
          <IsStatusOK ammo_min="{supply_ammo_min}"
                      hp_min="{supply_hp_min}"
                      hp_recover="{supply_hp_recover}"
                      key_port="{@referee_robotStatus}"/>
        </Inverter>
        <!-- 按区域选补给路线 (已锁定则复用本次路线) -->
        <SelectSupplyRouteByArea base_frame="base_link"
                                 map_frame="map"
                                 our_half_route="{supply_our_half_route}"
                                 u_inner_route="{supply_u_inner_route}"
                                 highland_route="{supply_highland_route}"
                                 our_half_polygon="{supply_our_half_polygon}"
                                 u_inner_polygon="{supply_u_inner_polygon}"
                                 highland_polygon="{supply_highland_polygon}"
                                 supply_route_locked="{supply_route_locked}"
                                 selected_supply_route="{selected_supply_route}"/>
        <!-- 沿选定路线前往补给区 -->
        <SubTree ID="run_route" route_file="{selected_supply_route}"
                               route_waypoints="{route_waypoints}"
                               route_wait_times="{route_wait_times}"
                               route_total_wp="{route_total_wp}"
                               route_wp_idx="{route_wp_idx}"
                               current_goal="{current_goal}"
                               current_wait_sec="{current_wait_sec}"/>
        <!-- 到达补给点后停在原地，直到血量和弹量恢复 -->
        <RetryUntilSuccessful num_attempts="1000000">
          <IsStatusOK ammo_min="{supply_ammo_min}"
                      hp_min="{supply_hp_min}"
                      hp_recover="{supply_hp_recover}"
                      key_port="{@referee_robotStatus}"/>
        </RetryUntilSuccessful>
      </SequenceWithMemory>
      <ForceFailure>
        <SubTree ID="reset_supply_route"/>
      </ForceFailure>
    </Fallback>
  </BehaviorTree>

  <!-- ═══════════════════════════════════════════════
       P3: 保卫基地
       说明: 我方基地 HP 低于阈值时, 去基地附近走防守路线
       _while 条件: our_base_hp < threshold
       ═══════════════════════════════════════════════ -->
  <BehaviorTree ID="protect_base">
    <Sequence _while="our_base_hp&lt;base_protect_hp_threshold">
      <SubTree ID="run_route" route_file="{base_protect_route}"
                             route_waypoints="{route_waypoints}"
                             route_wait_times="{route_wait_times}"
                             route_total_wp="{route_total_wp}"
                             route_wp_idx="{route_wp_idx}"
                             current_goal="{current_goal}"
                             current_wait_sec="{current_wait_sec}"/>
    </Sequence>
  </BehaviorTree>

  <!-- ═══════════════════════════════════════════════
       P4: 敌情响应 (与 test_spin_nav_aim.xml 完全一致)
       说明: 检测到敌人则停底盘, 交给自瞄打
       ═══════════════════════════════════════════════ -->
  <BehaviorTree ID="engage_enemy">
    <Sequence>
      <IsDetectEnemy armor_id="1;2;3;4;5;7"
                     max_distance="8.0"
                     key_port="{@detector_armors}"/>
      <PublishModeControl chassis_gyro="1"
                          patrol_mode="255"
                          power_mode="12"
                          duration="0"
                          topic_name="/mode_ctrl"/>
      <PublishTwist v_y="0.0"
                    v_yaw="0.0"
                    v_x="0.0"
                    duration="0"
                    topic_name="cmd_vel"/>
    </Sequence>
  </BehaviorTree>

  <!-- ═══════════════════════════════════════════════
       P5: 施压前哨站
       说明: 敌方前哨站存活时, 去前哨站附近多点路线骚扰
       _while 条件: enemy_outpost_hp > 0
       ═══════════════════════════════════════════════ -->
  <BehaviorTree ID="pressure_outpost">
    <Sequence _while="enemy_outpost_hp&gt;0">
      <SubTree ID="run_route" route_file="{outpost_pressure_route}"
                             route_waypoints="{route_waypoints}"
                             route_wait_times="{route_wait_times}"
                             route_total_wp="{route_total_wp}"
                             route_wp_idx="{route_wp_idx}"
                             current_goal="{current_goal}"
                             current_wait_sec="{current_wait_sec}"/>
    </Sequence>
  </BehaviorTree>

  <!-- ═══════════════════════════════════════════════
       P6: 按阶段巡逻
       说明:
         前期 (stage_remain_time > patrol_phase_threshold): 走前期巡逻路线
         后期 (stage_remain_time <= patrol_phase_threshold): 走后期巡逻路线
       ═══════════════════════════════════════════════ -->
  <BehaviorTree ID="patrol_by_phase">
    <ReactiveFallback>
      <!-- 前期: stage_remain_time 大于阈值时走前期路线 -->
      <Sequence _while="stage_remain_time&gt;patrol_phase_threshold">
        <SubTree ID="run_route" route_file="{patrol_early_route}"
                               route_waypoints="{route_waypoints}"
                               route_wait_times="{route_wait_times}"
                               route_total_wp="{route_total_wp}"
                               route_wp_idx="{route_wp_idx}"
                               current_goal="{current_goal}"
                               current_wait_sec="{current_wait_sec}"/>
      </Sequence>
      <!-- 后期: 走后期收缩路线 -->
      <SubTree ID="run_route" route_file="{patrol_late_route}"
                             route_waypoints="{route_waypoints}"
                             route_wait_times="{route_wait_times}"
                             route_total_wp="{route_total_wp}"
                             route_wp_idx="{route_wp_idx}"
                             current_goal="{current_goal}"
                             current_wait_sec="{current_wait_sec}"/>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- ═══════════════════════════════════════════════
       主树: rmuc_2026
       结构: 比赛开始门控 → ReactiveFallback 7优先级
       ═══════════════════════════════════════════════ -->
  <BehaviorTree ID="rmuc_2026">
    <!-- 外层死循环, ForceSuccess 防止任何节点的 FAILURE 传播出来终止树 -->
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <ReactiveSequence>
          <!-- P0: 比赛开始门控 -->
          <SubTree ID="check_game_start"/>

          <!-- P1-P6: 策略优先级 (ReactiveFallback: 每 tick 重新评估) -->
          <ReactiveFallback>

            <!-- P1: 死亡 (HP==0, 最高优先级) -->
            <SubTree ID="check_death"/>

            <!-- P2: 补给 (HP/弹药不足) -->
            <SubTree ID="check_supply"/>

            <!-- P3: 保卫基地 -->
            <SubTree ID="protect_base"/>

            <!-- P4: 敌情响应 (检测到敌人则停车自瞄) -->
            <SubTree ID="engage_enemy"/>

            <!-- P5: 施压前哨站 -->
            <SubTree ID="pressure_outpost"/>

            <!-- P6: 按阶段巡逻 (兜底) -->
            <SubTree ID="patrol_by_phase"/>

          </ReactiveFallback>
        </ReactiveSequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- ═══════════════════════════════════════════════
       节点模型 (Groot2 可视化用)
       ═══════════════════════════════════════════════ -->
  <TreeNodesModel>
    <!-- Conditions -->
    <Condition ID="IsGameStatus">
      <input_port name="expected_game_progress" default="4" type="int">Expected game progress stage</input_port>
      <input_port name="key_port" default="{@referee_gameStatus}"
                  type="robot_msgs::msg::CompetitionInfo_&lt;std::allocator&lt;void&gt; &gt;">CompetitionInfo port on blackboard</input_port>
    </Condition>
    <Condition ID="IsStatusOK">
      <input_port name="ammo_min" default="0" type="int">Lower then minimum ammo will return FAILURE</input_port>
      <input_port name="hp_min" default="200" type="int">HP threshold to start retreat</input_port>
      <input_port name="hp_recover" default="400" type="int">HP threshold to stop retreat (full HP)</input_port>
      <input_port name="key_port" default="{@referee_robotStatus}"
                  type="robot_msgs::msg::CompetitionInfo_&lt;std::allocator&lt;void&gt; &gt;">CompetitionInfo port on blackboard</input_port>
    </Condition>
    <Condition ID="IsDetectEnemy">
      <input_port name="armor_id" default="1;2;3;4;5;7"
                  type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;">Expected id of armors</input_port>
      <input_port name="max_distance" default="8.000000" type="float">Distance to enemy target</input_port>
      <input_port name="key_port" default="{@detector_armors}"
                  type="auto_aim_interfaces::msg::Armors_&lt;std::allocator&lt;void&gt; &gt;">Vision detector port on blackboard</input_port>
    </Condition>
    <!-- Actions -->
    <Action ID="Nav2Pose">
      <input_port name="goal" default="0;0;0"
                  type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Expected goal pose. Fill with format `x;y;yaw`</input_port>
      <input_port name="action_name" default="navigate_to_pose" type="std::string">Action server name</input_port>
      <input_port name="goal_pose_topic" default="/goal_pose" type="std::string">Goal pose topic for yaw controller</input_port>
    </Action>
    <Action ID="PublishModeControl">
      <input_port name="chassis_gyro" default="0" type="int">0: off, 1: on, 2: alignment correction</input_port>
      <input_port name="patrol_mode" default="2" type="int">Patrol mode (2=normal, 255=relax)</input_port>
      <input_port name="power_mode" default="12" type="int">Power mode (12=charge)</input_port>
      <input_port name="duration" default="0" type="int">Duration in ms</input_port>
      <input_port name="topic_name" default="/mode_ctrl" type="std::string">Topic name</input_port>
    </Action>
    <Action ID="PublishTwist">
      <input_port name="v_x" default="0.000000" type="double">Linear X velocity (m/s)</input_port>
      <input_port name="v_y" default="0.000000" type="double">Linear Y velocity (m/s)</input_port>
      <input_port name="v_yaw" default="0.000000" type="double">Angular Z velocity (rad/s)</input_port>
      <input_port name="duration" default="0" type="std::chrono::milliseconds">Publish duration in ms</input_port>
      <input_port name="topic_name" default="cmd_vel" type="std::string">Topic name</input_port>
    </Action>
    <Action ID="LoadWaypoints">
      <input_port name="waypoint_file" default="" type="std::string">CSV 路线文件路径，支持包内路径和 COD waypoint_editor 格式</input_port>
      <output_port name="waypoints" default="{route_waypoints}"
                   type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt;&gt;&gt;">航点列表</output_port>
      <output_port name="wait_times" default="{route_wait_times}"
                   type="std::vector&lt;double&gt;">等待时长列表</output_port>
      <output_port name="total_waypoints" default="{route_total_wp}" type="int">航点总数</output_port>
      <output_port name="wp_idx" default="{route_wp_idx}" type="int">当前航点索引</output_port>
    </Action>
    <Action ID="GetCurrentWaypoint">
      <input_port name="waypoints" default="{route_waypoints}"
                  type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt;&gt;&gt;">航点列表</input_port>
      <input_port name="wait_times" default="{route_wait_times}"
                  type="std::vector&lt;double&gt;">等待时长列表</input_port>
      <input_port name="wp_idx" default="{route_wp_idx}" type="int">当前索引</input_port>
      <output_port name="current_goal" default="{current_goal}"
                   type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt;&gt;">当前目标位姿</output_port>
      <output_port name="current_wait_sec" default="{current_wait_sec}" type="double">当前等待秒数</output_port>
    </Action>
    <Action ID="WaitDuration">
      <input_port name="wait_sec" default="0.0" type="double">等待时长（秒）</input_port>
    </Action>
    <Action ID="NextWaypoint">
      <input_port name="total_waypoints" default="{route_total_wp}" type="int">航点总数</input_port>
      <inout_port name="wp_idx" default="{route_wp_idx}" type="int">当前航点索引</inout_port>
    </Action>
    <Action ID="SelectSupplyRouteByArea">
      <input_port name="base_frame" default="base_link" type="std::string">机器人底盘 TF 坐标系</input_port>
      <input_port name="map_frame" default="map" type="std::string">地图坐标系</input_port>
      <input_port name="our_half_route" default="" type="std::string">我方半场 CSV 路线文件</input_port>
      <input_port name="u_inner_route" default="" type="std::string">U 字通道内部 CSV 路线文件</input_port>
      <input_port name="highland_route" default="" type="std::string">中央高地 CSV 路线文件</input_port>
      <input_port name="our_half_polygon" default="" type="std::string">我方半场四边形顶点</input_port>
      <input_port name="u_inner_polygon" default="" type="std::string">U 字通道四边形顶点</input_port>
      <input_port name="highland_polygon" default="" type="std::string">中央高地四边形顶点</input_port>
      <inout_port name="supply_route_locked" default="{supply_route_locked}" type="bool">是否已锁定路线</inout_port>
      <inout_port name="selected_supply_route" default="{selected_supply_route}" type="std::string">选定的路线文件</inout_port>
    </Action>
    <Action ID="ResetSupplyRoute">
      <output_port name="supply_route_locked" default="{supply_route_locked}" type="bool">锁定标志写回</output_port>
      <output_port name="selected_supply_route" default="{selected_supply_route}" type="std::string">选定的路线文件</output_port>
    </Action>
    <!-- Decorators -->
    <Decorator ID="TickAfterTimeout">
      <input_port name="timeout" type="float">time in s to wait before ticking child again</input_port>
    </Decorator>
    <!-- Controls -->
    <Control ID="RecoveryNode">
      <input_port name="num_attempts" default="999" type="int">Number of retries</input_port>
    </Control>
  </TreeNodesModel>

</root>
