<?xml version="1.0" encoding="UTF-8"?>
<!--
  RMUC 2026 哨兵主行为树
  策略层: 
    check_game_start   — 比赛未开始则停车等待
    check_supply       — HP/弹药不足, 单点回补给
    engage_enemy       — 检测到敌人, 停底盘交给自瞄
    pressure_outpost   — 敌方前哨站存活, 单点压前哨
    protect_base       — 我方基地 HP 低, 单点去基地附近守护
    post_outpost_behavior — 前哨站死亡后, 按赛前配置执行行为

-->
<root BTCPP_format="4">

  <!-- 工具子树: 多点路线执行器
       加载 CSV 路线后逐点执行, 到达最后一个航点后返回 SUCCESS
       目前没有启用多点导航 -->
  <BehaviorTree ID="run_route">
    <!-- 先加载路线, 再逐点执行 -->
    <SequenceWithMemory>
      <LoadWaypoints waypoint_file="{route_file}"
                     waypoints="{route_waypoints}"
                     wait_times="{route_wait_times}"
                     total_waypoints="{route_total_wp}"
                     wp_idx="{route_wp_idx}"/>
      <!-- NextWaypoint 到尾时返回 FAILURE; 这里把它视为路线正常完成。 -->
      <ForceSuccess>
        <KeepRunningUntilFailure>
          <Sequence>
            <GetCurrentWaypoint waypoints="{route_waypoints}"
                                wait_times="{route_wait_times}"
                                wp_idx="{route_wp_idx}"
                                current_goal="{current_goal}"
                                current_wait_sec="{current_wait_sec}"/>
            <!-- 导航途中: 小陀螺 + 正常移动模式 -->
            <PublishModeControl chassis_gyro="1"
                                patrol_mode="2"
                                power_mode="12"
                                rough_road_active="{@rough_road_active}"
                                rough_chassis_gyro="0"
                                duration="0"
                                topic_name="/mode_ctrl"/>
            <!-- 当前多点实现是逐点 NavigateToPose，不是 ThroughPoses。 -->
            <ForceSuccess>
              <Nav2Pose action_name="navigate_to_pose"
                        goal_pose_topic="/goal_pose"
                        goal="{current_goal}"
                        cmd_vel_topic="cmd_vel"/>
            </ForceSuccess>
            <!-- 到达航点后等待 wait_sec -->
            <WaitDuration wait_sec="{current_wait_sec}"/>
            <!-- 推进到下一航点; 到尾则重置 idx 并返回 FAILURE -->
            <NextWaypoint wp_idx="{route_wp_idx}"
                          total_waypoints="{route_total_wp}"/>
          </Sequence>
        </KeepRunningUntilFailure>
      </ForceSuccess>
    </SequenceWithMemory>
  </BehaviorTree>

  <!-- 单点导航 用 Nav2Pose 接口 -->
  <BehaviorTree ID="navigate_single_goal">
    <Sequence>
      <PublishModeControl chassis_gyro="1"
                          patrol_mode="2"
                          power_mode="12"
                          rough_road_active="{@rough_road_active}"
                          rough_chassis_gyro="0"
                          duration="0"
                          topic_name="/mode_ctrl"/>
      <ForceSuccess>
        <Nav2Pose action_name="navigate_to_pose"
                  goal_pose_topic="/goal_pose"
                  goal="{single_goal}"
                  cmd_vel_topic="cmd_vel"/>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <!-- 到达单点后定期重发目标，保持姿态和位置纠偏 -->
  <BehaviorTree ID="hold_single_goal">
    <Sequence>
      <SubTree ID="navigate_single_goal" single_goal="{single_goal}"/>
      <KeepRunningUntilFailure>
        <Sequence>
          <PublishModeControl chassis_gyro="2"
                              patrol_mode="2"
                              power_mode="12"
                              rough_road_active="{@rough_road_active}"
                              rough_chassis_gyro="0"
                              duration="0"
                              topic_name="/mode_ctrl"/>
          <ForceSuccess>
            <TickAfterTimeout timeout="{@single_goal_refresh_sec}"
                              goal="{single_goal}">
              <Nav2Pose action_name="navigate_to_pose"
                        goal_pose_topic="/goal_pose"
                        goal="{single_goal}"
                        cmd_vel_topic="cmd_vel"/>
            </TickAfterTimeout>
          </ForceSuccess>
        </Sequence>
      </KeepRunningUntilFailure>
    </Sequence>
  </BehaviorTree>

  <!-- 巡逻点切换不应被 Nav2 的偶发 aborted 卡死。
       这里等待导航结束，但不强制要求SUCCESS，结束后直接切下一个巡逻点。 -->
  <BehaviorTree ID="navigate_patrol_goal">
    <Sequence>
      <PublishModeControl chassis_gyro="1"
                          patrol_mode="2"
                          power_mode="12"
                          rough_road_active="{@rough_road_active}"
                          rough_chassis_gyro="0"
                          duration="0"
                          topic_name="/mode_ctrl"/>
      <ForceSuccess>
        <Nav2Pose action_name="navigate_to_pose"
                  goal_pose_topic="/goal_pose"
                  goal="{single_goal}"
                  cmd_vel_topic="cmd_vel"/>
      </ForceSuccess>
    </Sequence>
  </BehaviorTree>

  <!-- 比赛开始判定 未开始则停车等待 -->
  <BehaviorTree ID="check_game_start">
    <Fallback>
      <IsGameStatus name="IsGameStart"
                    expected_game_progress="4"
                    key_port="{@referee_gameStatus}"/>
      <ForceFailure>
        <Sequence>
          <PublishModeControl chassis_gyro="0"
                              patrol_mode="255"
                              power_mode="12"
                              duration="0.0"
                              topic_name="/mode_ctrl"/>
          <PublishTwist v_y="0.0"
                        v_yaw="0.0"
                        v_x="0.0"
                        duration="0.0"
                        topic_name="cmd_vel"/>
        </Sequence>
      </ForceFailure>
    </Fallback>
  </BehaviorTree>

  <!-- 回家补给逻辑 根据 IsStatusOK 的返回值判断 -->
  <BehaviorTree ID="check_supply">
    <!-- ReactiveSequence: 每次 tick 都先重查状态，低血/低弹立即切回家，恢复后立即退出补给。 -->
    <ReactiveSequence>
      <Inverter>
        <IsStatusOK ammo_min="{@supply_ammo_min}"
                    hp_min="{@supply_hp_min}"
                    hp_recover="{@supply_hp_recover}"
                    key_port="{@referee_robotStatus}"/>
      </Inverter>
      <!-- 低血/低弹时持续占据补给点；状态恢复后上一条件失效，本子树会被立即中断。 -->
      <SubTree ID="hold_single_goal" single_goal="{@supply_goal}"/>
    </ReactiveSequence>
  </BehaviorTree>

  <!--  保卫基地模式 -->
  <BehaviorTree ID="protect_base">
    <Sequence _while="@our_base_hp&lt;@base_protect_hp_threshold">
      <SubTree ID="hold_single_goal" single_goal="{@base_protect_goal}"/>
    </Sequence>
  </BehaviorTree>

  <!-- 发现敌人分支 -->
  <BehaviorTree ID="engage_enemy">
    <EnemyStopGate max_distance="8.0"
                   stale_timeout_sec="0.3"
                   linger_sec="0.8"
                   key_port="{@target_info}"
                   rx_time_sec="{@target_info_rx_time_sec}"
                   rough_road_active="{@rough_road_active}"
                   rough_chassis_gyro="0"/>
  </BehaviorTree>

  <!-- 锁存式手发点分支：一旦收到点，就持续占据该点，直到新点覆盖 -->
  <BehaviorTree ID="manual_nav_latched">
    <ReactiveSequence>
      <IsBlackboardBool value="{manual_nav_goal_set}" expected="true"/>
      <SubTree ID="hold_single_goal" single_goal="{manual_nav_goal}"/>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- 姿态管理：/sentry_posture_cmd, 1=进攻, 2=防御 -->
  <BehaviorTree ID="manage_posture">
    <SentryPostureManager topic_name="/sentry_posture_cmd"
                          status_port="{@referee_robotStatus}"
                          enemy_port="{@target_info}"
                          enemy_rx_time_sec="{@target_info_rx_time_sec}"
                          enemy_max_distance="{@posture_enemy_max_distance}"
                          enemy_stale_timeout_sec="{@posture_enemy_stale_timeout_sec}"
                          cooldown_sec="{@posture_cooldown_sec}"
                          linger_sec="{@posture_linger_sec}"/>
  </BehaviorTree>

  <!-- 压前哨 -->
  <BehaviorTree ID="pressure_outpost">
    <Sequence _while="@enemy_outpost_hp&gt;0">
      <SubTree ID="hold_single_goal" single_goal="{@outpost_pressure_goal}"/>
    </Sequence>
  </BehaviorTree>

  <!-- 默认的高地双点巡逻 -->
  <BehaviorTree ID="patrol_by_phase">
    <KeepRunningUntilFailure>
      <Sequence>
        <SubTree ID="navigate_patrol_goal" single_goal="{@patrol_point_a_goal}"/>
        <SubTree ID="navigate_patrol_goal" single_goal="{@patrol_point_b_goal}"/>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- 前哨站击杀后 默认占点保持 -->
  <BehaviorTree ID="post_outpost_hold">
    <SubTree ID="hold_single_goal" single_goal="{@post_outpost_hold_goal}"/>
  </BehaviorTree>

  <!-- 前哨站击杀后 hold_point 模式的前 5 分钟抢占点 占领敌方增益区 -->
  <BehaviorTree ID="post_outpost_gain">
    <SubTree ID="hold_single_goal" single_goal="{@enemy_outpost_gain_point}"/>
  </BehaviorTree>

  <!-- 前哨站击杀后 备用双点巡逻 -->
  <BehaviorTree ID="post_outpost_alt_patrol">
    <KeepRunningUntilFailure>
      <Sequence>
        <SubTree ID="navigate_patrol_goal" single_goal="{@post_outpost_alt_point_a_goal}"/>
        <SubTree ID="navigate_patrol_goal" single_goal="{@post_outpost_alt_point_b_goal}"/>
      </Sequence>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!-- 前哨站击杀后行为选择 -->
  <BehaviorTree ID="post_outpost_behavior">
    <Fallback>
      <Sequence>
        <IsBlackboardString value="{@post_outpost_behavior_mode}"
                           expected="hold_point"/>
        <Fallback>
          <Sequence _while="@our_outpost_hp&gt;0 &amp;&amp; @stage_remain_time&gt;=120">
            <SubTree ID="post_outpost_gain"/>
          </Sequence>
          <SubTree ID="post_outpost_hold"/>
        </Fallback>
      </Sequence>
      <Sequence>
        <IsBlackboardString value="{@post_outpost_behavior_mode}"
                           expected="alt_patrol"/>
        <SubTree ID="post_outpost_alt_patrol"/>
      </Sequence>
      <SubTree ID="patrol_by_phase"/>
    </Fallback>
  </BehaviorTree>

  <!-- 主树: rmuc_2026  -->
  <BehaviorTree ID="rmuc_2026">
    <!-- 外层死循环, ForceSuccess 防止任何节点的 FAILURE 传播出来终止树 -->
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <ReactiveSequence>
          <!--  比赛开始 -->
          <SubTree ID="check_game_start"/>
          <SubTree ID="manage_posture"/>
          <RoughRoadSpeedControl rough_road_polygon="{@rough_road_polygon}"
                                 rough_road_active="{@rough_road_active}"
                                 publish_mode_control="true"
                                 mode_topic="/mode_ctrl"
                                 rough_chassis_gyro="0"
                                 normal_chassis_gyro="1"
                                 patrol_mode="2"
                                 power_mode="12"
                                 control_speed="false"
                                 map_frame="map"
                                 base_frame="base_footprint"/>

          <!-- 每 tick 捕获 /competition_info 的手发点，即使当前被补给或敌情分支抢占。 -->
          <ForceSuccess>
            <UpdateManualNavGoal competition_port="{@referee_robotStatus}"
                                 our_side="{@our_side}"
                                 field_length_m="{@field_length_m}"
                                 field_width_m="{@field_width_m}"
                                 map_offset_x="{@manual_nav_map_offset_x}"
                                 map_offset_y="{@manual_nav_map_offset_y}"
                                 goal_yaw="{@manual_nav_goal_yaw}"
                                 goal="{@manual_nav_goal}"
                                 goal_set="{@manual_nav_goal_set}"/>
          </ForceSuccess>

          <!--  策略优先级  -->
          <ReactiveFallback>

            <!-- P1: 补给  -->
            <SubTree ID="check_supply"/>

            <!-- P2: 敌情响应  -->
            <SubTree ID="engage_enemy"/>

            <!-- P3: 锁存式手发点 -->
            <SubTree ID="manual_nav_latched" manual_nav_goal="{@manual_nav_goal}" manual_nav_goal_set="{@manual_nav_goal_set}"/>

            <!-- P4: 压前哨 -->
            <SubTree ID="pressure_outpost"/>

            <!-- P5: 保卫基地 -->
            <SubTree ID="protect_base"/>

            <!-- P6: 前哨站击杀后行为  -->
            <SubTree ID="post_outpost_behavior"/>

          </ReactiveFallback>
        </ReactiveSequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <!--  节点模型，主要用于 Groot2 可视化 -->
  <TreeNodesModel>
    <!-- Conditions -->
    <Condition ID="IsGameStatus">
      <input_port name="expected_game_progress" default="4" type="int">Expected game progress stage</input_port>
      <input_port name="key_port" default="{@referee_gameStatus}"
                  type="robot_msgs::msg::CompetitionInfo_&lt;std::allocator&lt;void&gt; &gt;">CompetitionInfo port on blackboard</input_port>
    </Condition>
    <Condition ID="IsStatusOK">
      <input_port name="ammo_min" default="0" type="int">Lower then minimum ammo will return FAILURE</input_port>
      <input_port name="hp_min" default="200" type="int">HP threshold to start retreat</input_port>
      <input_port name="hp_recover" default="400" type="int">HP threshold to stop retreat (full HP)</input_port>
      <input_port name="key_port" default="{@referee_robotStatus}"
                  type="robot_msgs::msg::CompetitionInfo_&lt;std::allocator&lt;void&gt; &gt;">CompetitionInfo port on blackboard</input_port>
    </Condition>
    <Condition ID="IsDetectEnemy">
      <input_port name="armor_id" default="1;2;3;4;5;7"
                  type="std::vector&lt;int, std::allocator&lt;int&gt; &gt;">Expected id of armors</input_port>
      <input_port name="max_distance" default="8.000000" type="float">Distance to enemy target</input_port>
      <input_port name="key_port" default="{@detector_armors}"
                  type="auto_aim_interfaces::msg::Armors_&lt;std::allocator&lt;void&gt; &gt;">Vision detector port on blackboard</input_port>
    </Condition>
    <Condition ID="EnemyStopGate">
      <input_port name="max_distance" default="8.000000" type="float">Distance to enemy target</input_port>
      <input_port name="stale_timeout_sec" default="0.300000" type="double">Treat stale target messages as no enemy</input_port>
      <input_port name="linger_sec" default="0.800000" type="double">Keep stop state after last valid enemy</input_port>
      <input_port name="key_port" default="{@target_info}"
                  type="robot_msgs::msg::OmniPerception_&lt;std::allocator&lt;void&gt; &gt;">OmniPerception target info on blackboard</input_port>
      <input_port name="rx_time_sec" default="{@target_info_rx_time_sec}" type="double">Last target_info receive time in ROS time seconds</input_port>
      <input_port name="rough_road_active" default="false" type="bool">Override chassis gyro on rough road</input_port>
      <input_port name="rough_chassis_gyro" default="0" type="int">Chassis gyro value on rough road</input_port>
    </Condition>
    <Condition ID="IsBlackboardString">
      <input_port name="value" default="" type="std::string">Blackboard string value</input_port>
      <input_port name="expected" default="" type="std::string">Expected string value</input_port>
    </Condition>
    <Condition ID="IsBlackboardBool">
      <input_port name="value" default="false" type="bool">Blackboard bool value</input_port>
      <input_port name="expected" default="true" type="bool">Expected bool value</input_port>
    </Condition>
    <!-- Actions -->
    <Action ID="Nav2Pose">
      <input_port name="goal" default="0;0;0"
                  type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Expected goal pose. Fill with format `x;y;yaw`</input_port>
      <input_port name="action_name" default="navigate_to_pose" type="std::string">Action server name</input_port>
      <input_port name="goal_pose_topic" default="/goal_pose" type="std::string">Goal pose topic for yaw controller</input_port>
      <input_port name="cmd_vel_topic" default="cmd_vel" type="std::string">Twist topic used for halt command</input_port>
    </Action>
    <Action ID="PublishModeControl">
      <input_port name="chassis_gyro" default="0" type="int">0: off, 1: on, 2: alignment correction</input_port>
      <input_port name="patrol_mode" default="2" type="int">Patrol mode (2=normal, 255=relax)</input_port>
      <input_port name="power_mode" default="12" type="int">Power mode (12=charge)</input_port>
      <input_port name="rough_road_active" default="false" type="bool">Override chassis gyro on rough road</input_port>
      <input_port name="rough_chassis_gyro" default="0" type="int">Chassis gyro value on rough road</input_port>
      <input_port name="duration" default="0" type="int">Duration in ms</input_port>
      <input_port name="topic_name" default="/mode_ctrl" type="std::string">Topic name</input_port>
    </Action>
    <Action ID="RoughRoadSpeedControl">
      <input_port name="rough_road_polygon" default="{@rough_road_polygon}" type="std::string">Rough road polygon</input_port>
      <input_port name="map_frame" default="map" type="std::string">Map frame</input_port>
      <input_port name="base_frame" default="base_footprint" type="std::string">Robot base frame</input_port>
      <input_port name="controller_node" default="/controller_server" type="std::string">Nav2 controller server node</input_port>
      <input_port name="smoother_node" default="/velocity_smoother" type="std::string">Nav2 velocity smoother node</input_port>
      <input_port name="control_speed" default="true" type="bool">Set Nav2 speed parameters</input_port>
      <input_port name="publish_mode_control" default="true" type="bool">Publish rough road mode override</input_port>
      <input_port name="mode_topic" default="/mode_ctrl" type="std::string">Mode control topic</input_port>
      <input_port name="rough_chassis_gyro" default="0" type="int">Chassis gyro value on rough road</input_port>
      <input_port name="normal_chassis_gyro" default="1" type="int">Chassis gyro value after rough road</input_port>
      <input_port name="patrol_mode" default="2" type="int">Patrol mode on rough road</input_port>
      <input_port name="power_mode" default="12" type="int">Power mode on rough road</input_port>
      <output_port name="rough_road_active" type="bool">True when robot is inside rough road polygon</output_port>
    </Action>
    <Action ID="SentryPostureManager">
      <input_port name="topic_name" default="/sentry_posture_cmd" type="std::string">Posture command topic</input_port>
      <input_port name="status_port" default="{@referee_robotStatus}"
                  type="robot_msgs::msg::CompetitionInfo_&lt;std::allocator&lt;void&gt; &gt;">CompetitionInfo port on blackboard</input_port>
      <input_port name="enemy_port" default="{@target_info}"
                  type="robot_msgs::msg::OmniPerception_&lt;std::allocator&lt;void&gt; &gt;">OmniPerception target info on blackboard</input_port>
      <input_port name="enemy_rx_time_sec" default="{@target_info_rx_time_sec}" type="double">Last receive time of target_info</input_port>
      <input_port name="enemy_max_distance" default="8.0" type="double">Max enemy distance for attack posture</input_port>
      <input_port name="enemy_stale_timeout_sec" default="0.3" type="double">Enemy message stale timeout</input_port>
      <input_port name="cooldown_sec" default="5.0" type="double">Minimum seconds between posture switches</input_port>
      <input_port name="linger_sec" default="2.0" type="double">Posture condition linger time</input_port>
    </Action>
    <Action ID="PublishTwist">
      <input_port name="v_x" default="0.000000" type="double">Linear X velocity (m/s)</input_port>
      <input_port name="v_y" default="0.000000" type="double">Linear Y velocity (m/s)</input_port>
      <input_port name="v_yaw" default="0.000000" type="double">Angular Z velocity (rad/s)</input_port>
      <input_port name="duration" default="0" type="std::chrono::milliseconds">Publish duration in ms</input_port>
      <input_port name="topic_name" default="cmd_vel" type="std::string">Topic name</input_port>
    </Action>
    <Action ID="LoadWaypoints">
      <input_port name="waypoint_file" default="" type="std::string">CSV 路线文件路径，支持包内路径和 COD waypoint_editor 格式</input_port>
      <output_port name="waypoints" default="{route_waypoints}"
                   type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt;&gt;&gt;">航点列表</output_port>
      <output_port name="wait_times" default="{route_wait_times}"
                   type="std::vector&lt;double&gt;">等待时长列表</output_port>
      <output_port name="total_waypoints" default="{route_total_wp}" type="int">航点总数</output_port>
      <output_port name="wp_idx" default="{route_wp_idx}" type="int">当前航点索引</output_port>
    </Action>
    <Action ID="GetCurrentWaypoint">
      <input_port name="waypoints" default="{route_waypoints}"
                  type="std::vector&lt;geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt;&gt;&gt;">航点列表</input_port>
      <input_port name="wait_times" default="{route_wait_times}"
                  type="std::vector&lt;double&gt;">等待时长列表</input_port>
      <input_port name="wp_idx" default="{route_wp_idx}" type="int">当前索引</input_port>
      <output_port name="current_goal" default="{current_goal}"
                   type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt;&gt;">当前目标位姿</output_port>
      <output_port name="current_wait_sec" default="{current_wait_sec}" type="double">当前等待秒数</output_port>
    </Action>
    <Action ID="UpdateManualNavGoal">
      <input_port name="competition_port" default="{@referee_robotStatus}"
                  type="robot_msgs::msg::CompetitionInfo_&lt;std::allocator&lt;void&gt; &gt;">CompetitionInfo port on blackboard</input_port>
      <input_port name="our_side" default="{@our_side}" type="std::string">Current alliance side: red/blue/auto</input_port>
      <input_port name="field_length_m" default="{@field_length_m}" type="double">Field length in meters</input_port>
      <input_port name="field_width_m" default="{@field_width_m}" type="double">Field width in meters</input_port>
      <input_port name="map_offset_x" default="{@manual_nav_map_offset_x}" type="double">Offset from remapped field x to map x in meters</input_port>
      <input_port name="map_offset_y" default="{@manual_nav_map_offset_y}" type="double">Offset from remapped field y to map y in meters</input_port>
      <input_port name="goal_yaw" default="{@manual_nav_goal_yaw}" type="double">Yaw of the latched manual nav goal in radians</input_port>
      <output_port name="goal" default="{manual_nav_goal}"
                   type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt;&gt;">Latched manual navigation goal in map frame</output_port>
      <output_port name="goal_set" default="{manual_nav_goal_set}" type="bool">True when a manual navigation goal has been latched</output_port>
    </Action>
    <Action ID="WaitDuration">
      <input_port name="wait_sec" default="0.0" type="double">等待时长（秒）</input_port>
    </Action>
    <Action ID="NextWaypoint">
      <input_port name="total_waypoints" default="{route_total_wp}" type="int">航点总数</input_port>
      <inout_port name="wp_idx" default="{route_wp_idx}" type="int">当前航点索引</inout_port>
    </Action>
    <!-- Decorators -->
    <Decorator ID="TickAfterTimeout">
      <input_port name="timeout" type="float">time in s to wait before ticking child again</input_port>
      <input_port name="goal"
                  type="geometry_msgs::msg::PoseStamped_&lt;std::allocator&lt;void&gt; &gt;">Optional goal that triggers the child immediately when changed</input_port>
    </Decorator>
  </TreeNodesModel>

</root>
